# Hetzner Cloud API token: console.hetzner.com -> project -> Security -> API Tokens
# Needs Read & Write.
HCLOUD_TOKEN=

# Tailscale API access token: console.tailscale.com/admin/settings/keys
# Needs policy-file read and auth-key create.
TS_API_KEY=

# Tailnet name, e.g. "example.com" or "tail1a2b3.ts.net". "-" means
# "the default tailnet for this token" and is usually correct.
TS_TAILNET=-

# --- optional, shown with their defaults ---
# GHOST_HOSTNAME=ghost          # tailnet machine name; also the Funnel subdomain
# SERVER_TYPE=cx23              # 2 vCPU / 4 GB, x86, EU locations
# SERVER_IMAGE=ubuntu-24.04
# SERVER_LOCATION=nbg1
# TS_TAG=tag:ghost
